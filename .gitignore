*~
.vscode
*.pdf

# PBS job output: <jobname>.o<jobid> and <jobname>.e<jobid>.
# Digit-anchored so ordinary *.o / *.e names are unaffected.
*.o[0-9]*
*.e[0-9]*

# Job output, when a job is submitted from the top of the checkout.  Anchored,
# so hpcrun/tests/fixtures/topology.json and the app.yaml files stay tracked.
/results.jsonl
/run.meta
/app.yaml
/topology.json
/modules.txt
/env.txt
/launcher.sh
/apptainer-launch-*.sh
/ldd_*.txt
/placement_*.out
/run_*/

# Python bytecode from hpcrun/benchlib.
__pycache__/
